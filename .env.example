# Non-secret example only. The current server reads process environment variables.
# This file is not loaded automatically. Prefer the Windows launcher for API keys.
PORT=3000
OPENAI_MODEL=gpt-4.1-mini
# Optional: WORKNOTE_DATA_DIR selects the folder containing data/worknote.db.
# Optional: WORKNOTE_PYTHON selects the Python executable (default python on Windows).
# OPENAI_API_KEY must be entered securely at runtime; never commit its value.
